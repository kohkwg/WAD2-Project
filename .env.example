# Copy to .env in the project root and fill in what you have.
# Every value is optional: the app falls back to estimates and sample data without it.
# Only VITE_ variables reach the browser. Never put a secret in a VITE_ variable.

# OneMap (server only). Used for address search and public transport routing.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# Geoapify (server only). Optional; place search falls back to manual entry.
GEOAPIFY_API_KEY=

# Gemini (pipeline only). Used to extract structured listings from posts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Telegram (pipeline only). Used to read channels that have no public preview.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Scheduled ingestion (optional). When true, the API server runs the pipeline
# every INGEST_INTERVAL_HOURS (1-6, default 2) and auto-publishes complete posts.
# PIPELINE_PYTHON is the Python with pipeline/requirements.txt installed; it
# defaults to pipeline/.venv if present, else `python`.
INGEST_ENABLED=false
INGEST_INTERVAL_HOURS=2
INGEST_LIMIT=15
PIPELINE_PYTHON=

# Local server port for the client to call.
PORT=8787
# Behind a hosting proxy, set the number of trusted proxy hops (usually 1) so
# rate limits apply per visitor instead of per proxy.
TRUST_PROXY=
VITE_API_BASE=http://localhost:8787

# Copy to .env in the project root and fill in what you have.
# Every value is optional: the app falls back to estimates and sample data without it.
# Only VITE_ variables reach the browser. Never put a secret in a VITE_ variable.

# OneMap (server only). Used for address search and public transport routing.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# Gemini (pipeline only). Used to extract structured listings from posts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Telegram (pipeline only). Used to read channels that have no public preview.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Google Calendar free/busy import (browser). A client ID is public by design.
VITE_GOOGLE_CLIENT_ID=

# Local server port for the client to call.
PORT=8787
VITE_API_BASE=http://localhost:8787

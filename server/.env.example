R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# HTTPS public bucket URL (custom domain or R2 public development URL).
R2_PUBLIC_URL=

PORT=3000

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional: OneMap account for live hangout travel routes (/api/route).
# Without these, hangouts show clearly labelled travel estimates instead.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# Optional: food near events for Go together's before/after planner (/api/food).
# Geoapify Places (free tier) for nearby restaurants and cafes; daily request cap.
GEOAPIFY_API_KEY=
GEOAPIFY_DAILY_LIMIT=1000
# The deals pipeline (pipeline/run.py): Gemini extraction and optional Telegram login.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
# Run the pipeline every few hours from this server (or POST /api/food/ingest/run locally).
FOOD_INGEST_ENABLED=false
FOOD_INGEST_INTERVAL_HOURS=6
FOOD_INGEST_LIMIT=15
PIPELINE_PYTHON=
